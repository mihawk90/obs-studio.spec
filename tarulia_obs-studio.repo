[tarulia_obs-studio]
name=Packagecloud repo for OBS Studio owned by Tarulia
baseurl=https://packagecloud.io/tarulia/obs-studio/fedora/$releasever/$basearch
repo_gpgcheck=0
gpgcheck=0
enabled=1
gpgkey=https://packagecloud.io/tarulia/obs-studio/gpgkey
metadata_expire=7d

[tarulia_obs-studio-pre]
name=Packagecloud repo for OBS Studio Preleases owned by Tarulia
baseurl=https://packagecloud.io/tarulia/obs-studio-pre/fedora/$releasever/$basearch
repo_gpgcheck=0
gpgcheck=0
enabled=0
gpgkey=https://packagecloud.io/tarulia/obs-studio-pre/gpgkey
metadata_expire=7d

